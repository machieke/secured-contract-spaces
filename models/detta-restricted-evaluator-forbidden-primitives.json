{
  "schema": "detta.restricted-evaluator-forbidden-primitive.v1",
  "schema_version": 1,
  "evaluator": "detta.restricted-script-evaluator",
  "max_steps": 1,
  "allowed_primitives": [
    "StateGet",
    "StateSet",
    "RegistryGet",
    "RegistrySetGuarded",
    "EmitEvent",
    "CallContract",
    "Abort",
    "PureArithmetic",
    "PureComparison",
    "PureData"
  ],
  "forbidden_cases": [
    {
      "primitive": "RawAddAtom",
      "script": [
        {
          "UsePrimitive": "RawAddAtom"
        }
      ],
      "expected_error": "ForbiddenPrimitive"
    },
    {
      "primitive": "RawRemoveAtom",
      "script": [
        {
          "UsePrimitive": "RawRemoveAtom"
        }
      ],
      "expected_error": "ForbiddenPrimitive"
    },
